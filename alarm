}

# Check for help flags
case "${1:-}" in
  --help|-help|-h|--ask|-ask|help)
    show_help
    ;;
esac

# Status dashboard
if [ "${1:-}" = "status" ] || [ "${1:-}" = "info" ] || [ "${1:-}" = "--status" ]; then
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --status
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --status
  fi
fi

# Volume control
if [ "${1:-}" = "volume" ] || [ "${1:-}" = "vol" ] || [ "${1:-}" = "--volume" ]; then
  if [ -n "${2:-}" ]; then
    if ! [[ "$2" =~ ^[0-9]+$ ]] || [ "$2" -lt 0 ] || [ "$2" -gt 100 ]; then
      echo "Error: Volume must be an integer between 0 and 100."
      exit 1
    fi
    set_config_val "volume" "$2"
    FILLED=$(( ($2 + 5) / 10 ))
    [ "$FILLED" -gt 10 ] && FILLED=10
    BAR="$(printf "%*s" "$FILLED" "" | tr ' ' '█')$(printf "%*s" "$((10 - FILLED))" "" | tr ' ' '░')"
    echo "✓ Volume set to $2% [$BAR]"
  else
    CUR_VOL="$(get_config_val "volume" "80")"
    FILLED=$(( ($CUR_VOL + 5) / 10 ))
    [ "$FILLED" -gt 10 ] && FILLED=10
    BAR="$(printf "%*s" "$FILLED" "" | tr ' ' '█')$(printf "%*s" "$((10 - FILLED))" "" | tr ' ' '░')"
    echo "Current volume: ${CUR_VOL}% [$BAR]"
    echo "Change volume: alarm volume <0-100>"
  fi
  exit 0
fi

# Mute audio
if [ "${1:-}" = "mute" ] || [ "${1:-}" = "--mute" ]; then
  set_config_val "muted" "true"
  echo "🔇 AI-Alarm muted (silent mode). Desktop notification banners will still trigger."
  exit 0
fi

# Unmute audio
if [ "${1:-}" = "unmute" ] || [ "${1:-}" = "--unmute" ]; then
  set_config_val "muted" "false"
  CUR_VOL="$(get_config_val "volume" "80")"
  echo "🔊 AI-Alarm unmuted (volume: ${CUR_VOL}%)."
  exit 0
fi

# Milestone & Team notification (Verified root agent dispatch)
if [ "${1:-}" = "milestone" ] || [ "${1:-}" = "--milestone" ]; then
  shift
  TASK_TITLE="Task Completed"
  SUMMARY="All objectives accomplished successfully."
  ACTION_NEEDED="No immediate action required."
  STATUS="completed"
  AGENT_NAME=""
  TARGET_DIR="$PWD"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task|-t)
        TASK_TITLE="$2"
        shift 2
        ;;
      --summary|-s)
        SUMMARY="$2"
        shift 2
        ;;
      --action|-a|--action-needed)
        ACTION_NEEDED="$2"
        shift 2
        ;;
      --status)
        STATUS="$2"
        shift 2
        ;;
      --agent)
        AGENT_NAME="$2"
        shift 2
        ;;
      --dir|-d)
        TARGET_DIR="$2"
        shift 2
        ;;
      *)
        if [ "$TASK_TITLE" = "Task Completed" ]; then
          TASK_TITLE="$1"
        elif [ "$SUMMARY" = "All objectives accomplished successfully." ]; then
          SUMMARY="$1"
        elif [ "$ACTION_NEEDED" = "No immediate action required." ]; then
          ACTION_NEEDED="$1"
        fi
        shift
        ;;
    esac
  done

  # Auto-detect agent if not passed
  if [ -z "$AGENT_NAME" ]; then
    if [ -n "${ANTIGRAVITY_AGENT:-}" ] || [ -n "${ANTIGRAVITY_APP_ROOT:-}" ]; then
      AGENT_NAME="antigravity"
    elif [ -n "${CLAUDE_SESSION_ID:-}" ]; then
      AGENT_NAME="claude"
    elif [ -n "${CODEX_SESSION_ID:-}" ]; then
      AGENT_NAME="codex"
    else
      AGENT_NAME="antigravity"
    fi
  fi

  echo "📢 Dispatching team milestone notification..."
  send_milestone_notification "$AGENT_NAME" "$TASK_TITLE" "$SUMMARY" "$ACTION_NEEDED" "$STATUS" "$TARGET_DIR"
  echo "✓ Verified milestone notification dispatched to Slack and desktop."
  exit 0
fi

# Desktop notifications management
if [ "${1:-}" = "notify" ] || [ "${1:-}" = "notification" ] || [ "${1:-}" = "--notify" ]; then
  case "${2:-}" in
    on|true|1|enable)
      set_config_val "desktop_notifications" "true"
      echo "🔔 Desktop notification banners enabled."
      ;;
    off|false|0|disable)
      set_config_val "desktop_notifications" "false"
      echo "🔕 Desktop notification banners disabled."
      ;;
    routine)
      case "${3:-}" in
        on|true|1|enable)
          set_config_val "routine_webhook" "true"
          echo "🔔 Routine Stop hook webhooks enabled (will send to Slack on every stop hook)."
          ;;
        off|false|0|disable)
          set_config_val "routine_webhook" "false"
          echo "🔕 Routine Stop hook webhooks disabled (Slack reserved for 'alarm milestone')."
          ;;
        *)
          CUR_RT="$(get_config_val "routine_webhook" "false")"
          echo "Routine Stop hook Slack alerts: $([ "$CUR_RT" = "true" ] && echo 'Enabled 🔔' || echo 'Disabled 🔕 (Milestones only)')"
          echo "Toggle with: alarm notify routine [on|off]"
          ;;
      esac
      ;;
    sound)
      case "${3:-}" in
        on|true|1|enable)
          set_config_val "notification_sound" "true"
          echo "🔊 Notification toast system sound enabled."
          ;;
        off|false|0|disable)
          set_config_val "notification_sound" "false"
          echo "🔇 Notification toast system sound disabled (silent toast)."
          ;;
        *)
          CUR_SND="$(get_config_val "notification_sound" "false")"
          echo "Notification toast sound: $([ "$CUR_SND" = "true" ] && echo 'Enabled 🔊' || echo 'Silent 🔇')"
          echo "Toggle with: alarm notify sound [on|off]"
          ;;
      esac
      ;;
    title)
      if [ -n "${3:-}" ]; then
        set_config_val "notification_title" "$3"
        echo "✓ Notification title set to: \"$3\""
      else
        echo "Usage: alarm notify title <custom_title>"
      fi
      ;;
    webhook)
      if [ -z "${3:-}" ]; then
        CUR_HOOK="$(get_config_val "webhook_url" "")"
        if [ -n "$CUR_HOOK" ]; then
          echo "Current webhook URL: $CUR_HOOK"
          echo "To clear: alarm notify webhook clear"
        else
          echo "No webhook configured."
          echo "Usage: alarm notify webhook <url>"
        fi
      elif [ "$3" = "clear" ] || [ "$3" = "off" ] || [ "$3" = "disable" ]; then
        set_config_val "webhook_url" ""
        echo "✓ Webhook alerts disabled and cleared."
      else
        set_config_val "webhook_url" "$3"
        echo "✓ Webhook URL configured: $3"
        echo "💡 Test with: alarm notify test"
      fi
      ;;
    test)
      echo "🚀 Sending verified test milestone notification..."
      send_milestone_notification "test" "AI-Alarm Test Milestone" "Testing rich Slack Block Kit notification with system context." "Verify that Slack shows the verified root milestone badge, project, branch, and time." "completed" "$PWD"
      echo "✓ Test notification dispatched (desktop toast & Slack Block Kit card)."
      ;;
    *)
      CUR_NOTIF="$(get_config_val "desktop_notifications" "true")"
      CUR_SND="$(get_config_val "notification_sound" "false")"
      CUR_TITLE="$(get_config_val "notification_title" "AI-Alarm")"
      CUR_HOOK="$(get_config_val "webhook_url" "")"
      CUR_RT="$(get_config_val "routine_webhook" "false")"

      echo ""
      echo "╔═══════════════════════════════════════════════════════════════════╗"
      echo "║               AI-ALARM NOTIFICATION SYSTEM MANAGER                ║"
      echo "╚═══════════════════════════════════════════════════════════════════╝"
      echo ""
      echo "  Desktop Banners:    $([ "$CUR_NOTIF" = "true" ] && echo "Enabled 🔔" || echo "Disabled 🔕")"
      echo "  Banner Chime:       $([ "$CUR_SND" = "true" ] && echo "Enabled 🔊" || echo "Silent 🔇")"
      echo "  Banner Title:       $CUR_TITLE"
      echo "  Webhook Alert:      $([ -n "$CUR_HOOK" ] && echo "Configured 🌐 ($CUR_HOOK)" || echo "None ⚪")"
      echo "  Routine Hook Post:  $([ "$CUR_RT" = "true" ] && echo "Enabled (Every subagent stop sends to Slack)" || echo "Disabled (Clean mode: only 'alarm milestone' sends to Slack)")"
      echo ""
      echo "  AVAILABLE COMMANDS:"
      echo "    alarm notify on               Enable desktop notification banners"
      echo "    alarm notify off              Disable desktop notification banners"
      echo "    alarm notify routine on|off   Toggle Slack posting on routine subagent stop hooks"
      echo "    alarm notify sound on|off     Toggle system chime in notification toasts"
      echo "    alarm notify title <text>     Customize notification banner title"
      echo "    alarm notify webhook <url>    Set Slack/Discord incoming webhook URL"
      echo "    alarm notify webhook clear    Disable webhook alerts"
      echo "    alarm notify test             Send test notification toast & webhook"
      echo ""
      ;;
  esac
  exit 0
fi

# Clean uninstaller
if [ "${1:-}" = "uninstall" ] || [ "${1:-}" = "--uninstall" ]; then
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --uninstall "${2:-}"
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --uninstall "${2:-}"
  fi
fi

# Prune / Clean unused sounds (free disk space, protect active agent sounds)
if [ "${1:-}" = "prune" ] || [ "${1:-}" = "--prune" ] || [ "${1:-}" = "clean" ] || [ "${1:-}" = "--clean" ]; then
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --prune
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --prune
  fi
fi

# Storage & Cache Info
if [ "${1:-}" = "storage" ] || [ "${1:-}" = "--storage" ] || [ "${1:-}" = "cache" ] || [ "${1:-}" = "--cache" ]; then
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --storage
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --storage
  fi
fi

# Restore / Download all community sounds
if [ "${1:-}" = "restore" ] || [ "${1:-}" = "--restore" ] || [ "${1:-}" = "download-all" ] || [ "${1:-}" = "--download-all" ]; then
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --restore
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --restore
  fi
fi

# Update community sounds from GitHub
if [ "${1:-}" = "update" ] || [ "${1:-}" = "--update" ] || [ "${1:-}" = "sync" ] || [ "${1:-}" = "--sync" ]; then
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --update
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --update
  fi
fi

# Search sounds
if [ "${1:-}" = "search" ] || [ "${1:-}" = "--search" ] || [ "${1:-}" = "find" ]; then
  if [ -z "${2:-}" ]; then
    echo "Usage: alarm search <keyword>"
    echo "Example: alarm search istighfar"
    echo "Example: alarm search prophet"
    exit 1
  fi
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --search "$2"
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --search "$2"
  fi
fi

# Set sound directly
if [ "${1:-}" = "set" ] || [ "${1:-}" = "--set" ]; then
  if [ -z "${2:-}" ]; then
    echo "Usage: alarm set <sound_filename_or_name> [agent]"
    exit 1
  fi
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" set "$2" "${3:-}"
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" set "$2" "${3:-}"
  fi
fi

# Open sound library in Finder / File Manager
if [ "${1:-}" = "open" ] || [ "${1:-}" = "--open" ] || [ "${1:-}" = "dir" ]; then
  mkdir -p "$INSTALL_DIR/sound"
  TARGET_DIR="$INSTALL_DIR/sound"
  if [ -n "$SOUND_DIR" ] && [ -d "$SOUND_DIR" ]; then
    TARGET_DIR="$SOUND_DIR"
  fi
  if command -v open >/dev/null 2>&1; then
    open "$TARGET_DIR"
    echo "✓ Opened sound library in Finder: $TARGET_DIR"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$TARGET_DIR"
    echo "✓ Opened sound library: $TARGET_DIR"
  else
    echo "Sound library located at: $TARGET_DIR"
  fi
  exit 0
fi

# Add / Import sound
if [ "${1:-}" = "add" ] || [ "${1:-}" = "--add" ]; then
  if [ -z "${2:-}" ]; then
    echo "Usage: alarm add <file_path_or_url>"
    echo "Example: alarm add ~/Downloads/alert.mp3"
    echo "Example: alarm add https://example.com/sound.mp3"
    exit 1
  fi
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --add "$2" "${3:-}"
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --add "$2" "${3:-}"
  fi
fi

# Remove / Delete sound
if [ "${1:-}" = "remove" ] || [ "${1:-}" = "rm" ] || [ "${1:-}" = "--remove" ] || [ "${1:-}" = "delete" ] || [ "${1:-}" = "--delete" ]; then
  if [ -z "${2:-}" ]; then
    echo "Usage: alarm remove <sound_name>"
    exit 1
  fi
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --remove "$2"
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --remove "$2"
  fi
fi

# Interactive selector flag
if [ "${1:-}" = "--select" ] || [ "${1:-}" = "-s" ]; then
  AGENT_ARG="${2:-}"
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --select-only "$AGENT_ARG"
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --select-only "$AGENT_ARG"
  else
    echo "Error: install.sh not found to run audio selector." >&2
    exit 1
  fi
fi

# List available sounds (Multi-format support)
if [ "${1:-}" = "--list" ] || [ "${1:-}" = "-l" ]; then
  if [ -z "$SOUND_DIR" ] || [ ! -d "$SOUND_DIR" ]; then
    echo "⚠ Sound directory not found. Expected at: $INSTALL_DIR/sound"
    exit 1
  fi
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo " 📁 Global Sound Library: $SOUND_DIR"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  shopt -s nullglob nocaseglob
  FOUND=0
  for f in "$SOUND_DIR"/*.{mp3,wav,m4a,aac,ogg,flac,aiff}; do
    if [ -f "$f" ]; then
      base="${f##*/}"
      ext="${base##*.}"
      name="${base%.*}"
      echo "  ♪ $name ($base)"
      FOUND=$((FOUND + 1))
    fi
  done
  if [ "$FOUND" -eq 0 ]; then
    echo "  (No sound tracks found)"
  fi
  echo ""
  echo "💡 Tip: Run 'alarm add <file_or_url>' or 'alarm open' to add sounds"
  exit 0
fi

# =================================================================
# Sound Playback & Agent Detection
# =================================================================

AGENT=""
case "${1:-}" in
  claude|codex|antigravity|opencode)
    AGENT="$1"
    ;;
  --agent)
    AGENT="${2:-}"
    ;;
esac

# Auto-detect caller if not explicitly passed
if [ -z "$AGENT" ]; then
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ] || [ -n "${CLAUDE_SESSION_ID:-}" ]; then
    AGENT="claude"
  elif [ -n "${CODEX_SESSION_ID:-}" ] || [ -n "${CODEX_PROJECT_ROOT:-}" ]; then
    AGENT="codex"
  else
    PARENT_COMM="$(ps -o comm= -p "$PPID" 2>/dev/null || true)"
    GRANDPARENT_PID="$(ps -o ppid= -p "$PPID" 2>/dev/null || true | tr -d ' ')"
    GRANDPARENT_COMM=""
    if [ -n "$GRANDPARENT_PID" ]; then
      GRANDPARENT_COMM="$(ps -o comm= -p "$GRANDPARENT_PID" 2>/dev/null || true)"
    fi
    CALLER_CHAIN="$PARENT_COMM $GRANDPARENT_COMM"

    if [[ "$CALLER_CHAIN" =~ claude ]]; then
      AGENT="claude"
    elif [[ "$CALLER_CHAIN" =~ codex ]]; then
      AGENT="codex"
    elif [[ "$CALLER_CHAIN" =~ (antigravity|agy) ]]; then
      AGENT="antigravity"
    elif [[ "$CALLER_CHAIN" =~ opencode ]]; then
      AGENT="opencode"
    fi
  fi
fi

# Locate Sound File
SOUND=""

find_audio_file() {
  local prefix="$1"
  shopt -s nullglob nocaseglob
  for candidate in "$prefix".{mp3,wav,m4a,aac,ogg,flac,aiff}; do
    if [ -f "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  echo ""
}

# 1. Agent custom sound
if [ -n "$AGENT" ]; then
  SOUND="$(find_audio_file "$INSTALL_DIR/alarm_sound_${AGENT}")"
  if [ -z "$SOUND" ]; then
    SOUND="$(find_audio_file "$DIR/alarm_sound_${AGENT}")"
  fi
fi

# 2. Global default sound
if [ -z "$SOUND" ]; then
  SOUND="$(find_audio_file "$INSTALL_DIR/alarm_sound")"
  if [ -z "$SOUND" ]; then
    SOUND="$(find_audio_file "$DIR/alarm_sound")"
  fi
fi

# 3. First sound in library
if [ -z "$SOUND" ] && [ -n "$SOUND_DIR" ] && [ -d "$SOUND_DIR" ]; then
  shopt -s nullglob nocaseglob
  FIRST_AUDIO=( "$SOUND_DIR"/*.{mp3,wav,m4a,aac,ogg,flac,aiff} )
  if [ -f "${FIRST_AUDIO[0]}" ]; then
    SOUND="${FIRST_AUDIO[0]}"
  fi
fi

if [ -z "$SOUND" ] || [ ! -f "$SOUND" ]; then
  echo "Error: No alarm sound found in $INSTALL_DIR or $DIR" >&2
  echo "Run 'alarm --help' or 'alarm --select' to configure." >&2
  exit 1
fi

# Play Sound using native system player
play_audio() {
  local MUTED="$(get_config_val "muted" "false")"
  if [ "$MUTED" = "true" ]; then
    return 0
  fi

  local VOL="$(get_config_val "volume" "80")"
  if ! [[ "$VOL" =~ ^[0-9]+$ ]] || [ "$VOL" -lt 0 ] || [ "$VOL" -gt 100 ]; then
    VOL=80
  fi

  if command -v afplay >/dev/null 2>&1; then
    local RATIO
    RATIO=$(awk -v v="$VOL" 'BEGIN { printf "%.2f", v / 100 }')
    afplay -v "$RATIO" "$SOUND"
  elif command -v paplay >/dev/null 2>&1; then
    local PAPLAY_VOL=$(( VOL * 65536 / 100 ))
    paplay --volume="$PAPLAY_VOL" "$SOUND"
  elif command -v mpv >/dev/null 2>&1; then
    mpv --no-video --volume="$VOL" "$SOUND" >/dev/null 2>&1
  elif command -v ffplay >/dev/null 2>&1; then
    ffplay -nodisp -autoexit -volume "$VOL" "$SOUND" >/dev/null 2>&1
  elif command -v aplay >/dev/null 2>&1; then
    aplay "$SOUND"
  else
    echo -e "\a"
  fi
}

# Trigger Desktop Notification Banner if enabled
DESKTOP_NOTIFY="$(get_config_val "desktop_notifications" "true")"
if [ "$DESKTOP_NOTIFY" != "false" ]; then
  send_desktop_notification "$AGENT"
fi

# If called by an agent hook or non-interactively, play in background so agent is not blocked
if [ -n "$AGENT" ] || [ ! -t 0 ]; then
  (play_audio >/dev/null 2>&1 &)
  # Antigravity hook contract expects JSON on stdout
  if [ "$AGENT" = "antigravity" ] || [ -n "${ANTIGRAVITY_APP_ROOT:-}" ] || [ -n "${AGY_CLI:-}" ]; then
    echo "{}"
  fi
  exit 0
else
  play_audio
fi
