#!/usr/bin/env bash
set -eo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="${HOME}/.ai-alarm"
CONFIG_FILE="$INSTALL_DIR/config.json"

get_config_val() {
  local key="$1"
  local default="$2"
  if [ -f "$CONFIG_FILE" ]; then
    node -e '
      const fs = require("fs");
      try {
        const c = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
        const v = c[process.argv[2]];
        if (v !== undefined) { console.log(String(v)); process.exit(0); }
      } catch(e){}
      console.log(String(process.argv[3]));
    ' "$CONFIG_FILE" "$key" "$default" 2>/dev/null || echo "$default"
  else
    echo "$default"
  fi
}

set_config_val() {
  local key="$1"
  local val="$2"
  mkdir -p "$INSTALL_DIR"
  node -e '
    const fs = require("fs");
    const p = process.argv[1];
    const key = process.argv[2];
    let val = process.argv[3];
    if (val === "true") val = true;
    else if (val === "false") val = false;
    else if (!isNaN(val) && val.trim() !== "") val = Number(val);

    let c = { volume: 80, muted: false, desktop_notifications: true };
    if (fs.existsSync(p)) {
      try { c = Object.assign(c, JSON.parse(fs.readFileSync(p, "utf8"))); } catch(e){}
    }
    c[key] = val;
    fs.writeFileSync(p, JSON.stringify(c, null, 2) + "\n");
  ' "$CONFIG_FILE" "$key" "$val" 2>/dev/null || true
}

send_desktop_notification() {
  local agent_name="${1:-}"
  local agent_title="AI Agent"
  case "$agent_name" in
    claude) agent_title="Claude Code" ;;
    codex) agent_title="OpenAI Codex" ;;
    antigravity) agent_title="Google Antigravity" ;;
    opencode) agent_title="OpenCode" ;;
    *) [ -n "$agent_name" ] && agent_title="$agent_name" ;;
  esac

  if [[ "$OSTYPE" == "darwin"* ]] && command -v osascript >/dev/null 2>&1; then
    (osascript -e "display notification \"Task completed by ${agent_title}!\" with title \"AI-Alarm\" subtitle \"Task Finished\" sound name \"\"" >/dev/null 2>&1 &)
  elif command -v notify-send >/dev/null 2>&1; then
    (notify-send "AI-Alarm" "Task completed by ${agent_title}!" --icon=dialog-information >/dev/null 2>&1 &)
  fi
}

# Resolve Global Sound Library Directory
SOUND_DIR=""
if [ -n "${AI_ALARM_SOUND_DIR:-}" ] && [ -d "$AI_ALARM_SOUND_DIR" ]; then
  SOUND_DIR="$AI_ALARM_SOUND_DIR"
elif [ -d "$INSTALL_DIR/sound" ]; then
  SOUND_DIR="$INSTALL_DIR/sound"
elif [ -d "$DIR/sound" ]; then
  SOUND_DIR="$DIR/sound"
fi

show_help() {
  cat << 'EOF'
╔═══════════════════════════════════════════════════════════════════╗
║                      AI-ALARM MANUAL & HELP                       ║
║  Cross-Agent Task Completion Audio Hooks & Alert Notification     ║
╚═══════════════════════════════════════════════════════════════════╝

USAGE:
    alarm [COMMAND | AGENT | OPTIONS]

COMMANDS & OPTIONS:
    alarm                     Play current alarm sound (auto-detects agent)
    alarm <agent>             Play custom sound assigned to specific agent
                              Supported: claude, codex, antigravity, opencode
    alarm status              Show configuration dashboard & agent hook health
    alarm storage             Show disk usage and local vs cloud sound breakdown (cache)
    alarm prune               Delete all unused sounds to free disk space (clean)
    alarm restore             Download all community sounds for offline use (download-all)
    alarm volume [0-100]      View or adjust alert playback volume (0-100%)
    alarm mute                Silence audio alerts (desktop notifications still fire)
    alarm unmute              Restore audio alerts
    alarm notify [on|off]     Toggle native desktop notification banners
    alarm --select [agent]    Interactive arrow-key sound selector (-s)
    alarm search <query>      Search sounds by title, description, or tag
    alarm update              Download latest community sounds from GitHub (sync)
    alarm set <sound> [agent] Directly activate a sound track without menu
    alarm --list              List all audio files in the global sound library (-l)
    alarm add <path|url>      Import a custom sound file or download from URL
    alarm open                Open the sound library directory in Finder / File Manager
    alarm remove <name>       Remove a sound file from local disk (rm, delete)
    alarm uninstall           Cleanly remove all hooks, binaries, and data
    alarm --help | -help      Show this documentation manual (-h, --ask, -ask)

