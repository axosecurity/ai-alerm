#!/usr/bin/env bash
set -eo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="${HOME}/.ai-alarm"

# Resolve Global Sound Library Directory
SOUND_DIR=""
if [ -n "${AI_ALARM_SOUND_DIR:-}" ] && [ -d "$AI_ALARM_SOUND_DIR" ]; then
  SOUND_DIR="$AI_ALARM_SOUND_DIR"
elif [ -d "$INSTALL_DIR/sound" ]; then
  SOUND_DIR="$INSTALL_DIR/sound"
elif [ -d "$DIR/sound" ]; then
  SOUND_DIR="$DIR/sound"
fi

show_help() {
  cat << 'EOF'
╔═══════════════════════════════════════════════════════════════════╗
║                      AI-ALARM MANUAL & HELP                       ║
║  Cross-Agent Task Completion Audio Hooks & Alert Notification     ║
╚═══════════════════════════════════════════════════════════════════╝

USAGE:
    alarm [COMMAND | AGENT | OPTIONS]

COMMANDS & OPTIONS:
    alarm                     Play current alarm sound (auto-detects agent)
    alarm <agent>             Play custom sound assigned to specific agent
                              Supported: claude, codex, antigravity, opencode
    alarm --select [agent]    Interactive arrow-key sound selector (-s)
    alarm search <query>      Search sounds by title, description, or tag
    alarm update              Download latest community sounds from GitHub (sync)
    alarm set <sound> [agent] Directly activate a sound track without menu
    alarm --list              List all audio files in the global sound library (-l)
    alarm add <path|url>      Import a custom sound file or download from URL
    alarm open                Open the sound library directory in Finder / File Manager
    alarm remove <name>       Remove a sound file from the library (rm)
    alarm --help | -help      Show this documentation manual (-h, --ask, -ask)

INTERACTIVE SELECTOR FEATURES:
    Run: alarm --select
    * [↑] / [↓] : Navigate between sounds
    * [Space]   : Toggle live audio preview (shows ▶ Playing...)
    * [/]       : Filter / Search sounds on the fly
    * [c]       : Cycle through categories ([All], [zikir], [durood], [istighfar])
    * [Enter]   : Confirm selection
    * [q]       : Cancel

    Shortcuts:
      alarm --select claude         Quickly configure Claude Code's sound
      alarm --select codex          Quickly configure OpenAI Codex's sound
      alarm --select antigravity    Quickly configure Google Antigravity's sound
      alarm --select opencode       Quickly configure OpenCode's sound
      alarm --select global         Quickly configure Global Default sound

DYNAMIC SOUND MANAGEMENT:
    📁 Global Sound Library:
        ~/.ai-alarm/sound/

    Supported audio formats:
        .mp3, .wav, .m4a, .aac, .ogg, .flac, .aiff

    Ways to manage sounds:
      1. Run: alarm update              (syncs latest community sounds from GitHub)
      2. Run: alarm search <keyword>    (searches titles, descriptions, and tags)
      3. Run: alarm add /path/to/sound  (imports custom sound)
      4. Run: alarm open                (opens Finder to drag & drop files!)

SUPPORTED AI AGENTS & HOOKS:
    🟣 Claude Code       ~/.claude/settings.json       (hooks.Stop)
    🟢 OpenAI Codex      ~/.codex/config.toml          ([[hooks.Stop]])
    🔵 Antigravity       ~/.gemini/config/hooks.json   (task-finished-alarm.Stop)
    🟡 OpenCode          ~/.config/opencode/plugins/   (session.idle)

EXAMPLES:
    alarm                     # Triggers alarm (used by hooks)
    alarm claude              # Play Claude's sound
    alarm --select            # Change sound interactively
    alarm search forgiveness  # Search for istighfar sounds
    alarm update              # Download new sounds from GitHub
    alarm add ~/alert.mp3     # Import custom sound
    alarm open                # Open sound directory in Finder
    alarm --list              # Show all available tracks
    alarm --help              # Show this manual
EOF
  exit 0
}

# Check for help flags
case "${1:-}" in
  --help|-help|-h|--ask|-ask|help)
    show_help
    ;;
esac

# Update community sounds from GitHub
if [ "${1:-}" = "update" ] || [ "${1:-}" = "--update" ] || [ "${1:-}" = "sync" ] || [ "${1:-}" = "--sync" ]; then
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --update
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --update
  fi
fi

# Search sounds
if [ "${1:-}" = "search" ] || [ "${1:-}" = "--search" ] || [ "${1:-}" = "find" ]; then
  if [ -z "${2:-}" ]; then
    echo "Usage: alarm search <keyword>"
    echo "Example: alarm search istighfar"
    echo "Example: alarm search prophet"
    exit 1
  fi
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --search "$2"
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --search "$2"
  fi
fi

# Set sound directly
if [ "${1:-}" = "set" ] || [ "${1:-}" = "--set" ]; then
  if [ -z "${2:-}" ]; then
    echo "Usage: alarm set <sound_filename_or_name> [agent]"
    exit 1
  fi
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" set "$2" "${3:-}"
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" set "$2" "${3:-}"
  fi
fi

# Open sound library in Finder / File Manager
if [ "${1:-}" = "open" ] || [ "${1:-}" = "--open" ] || [ "${1:-}" = "dir" ]; then
  mkdir -p "$INSTALL_DIR/sound"
  TARGET_DIR="$INSTALL_DIR/sound"
  if [ -n "$SOUND_DIR" ] && [ -d "$SOUND_DIR" ]; then
    TARGET_DIR="$SOUND_DIR"
  fi
  if command -v open >/dev/null 2>&1; then
    open "$TARGET_DIR"
    echo "✓ Opened sound library in Finder: $TARGET_DIR"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$TARGET_DIR"
    echo "✓ Opened sound library: $TARGET_DIR"
  else
    echo "Sound library located at: $TARGET_DIR"
  fi
  exit 0
fi

# Add / Import sound
if [ "${1:-}" = "add" ] || [ "${1:-}" = "--add" ]; then
  if [ -z "${2:-}" ]; then
    echo "Usage: alarm add <file_path_or_url>"
    echo "Example: alarm add ~/Downloads/alert.mp3"
    echo "Example: alarm add https://example.com/sound.mp3"
    exit 1
  fi
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --add "$2" "${3:-}"
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --add "$2" "${3:-}"
  fi
fi

# Remove sound
if [ "${1:-}" = "remove" ] || [ "${1:-}" = "rm" ] || [ "${1:-}" = "--remove" ]; then
  if [ -z "${2:-}" ]; then
    echo "Usage: alarm remove <sound_name>"
    exit 1
  fi
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --remove "$2"
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --remove "$2"
  fi
fi

# Interactive selector flag
if [ "${1:-}" = "--select" ] || [ "${1:-}" = "-s" ]; then
  AGENT_ARG="${2:-}"
  if [ -x "$DIR/install.sh" ]; then
    exec "$DIR/install.sh" --select-only "$AGENT_ARG"
  elif [ -x "$INSTALL_DIR/install.sh" ]; then
    exec "$INSTALL_DIR/install.sh" --select-only "$AGENT_ARG"
  else
    echo "Error: install.sh not found to run audio selector." >&2
    exit 1
  fi
fi

# List available sounds (Multi-format support)
if [ "${1:-}" = "--list" ] || [ "${1:-}" = "-l" ]; then
  if [ -z "$SOUND_DIR" ] || [ ! -d "$SOUND_DIR" ]; then
    echo "⚠ Sound directory not found. Expected at: $INSTALL_DIR/sound"
    exit 1
  fi
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo " 📁 Global Sound Library: $SOUND_DIR"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  shopt -s nullglob nocaseglob
  FOUND=0
  for f in "$SOUND_DIR"/*.{mp3,wav,m4a,aac,ogg,flac,aiff}; do
    if [ -f "$f" ]; then
      base="${f##*/}"
      ext="${base##*.}"
      name="${base%.*}"
      echo "  ♪ $name ($base)"
      FOUND=$((FOUND + 1))
    fi
  done
  if [ "$FOUND" -eq 0 ]; then
    echo "  (No sound tracks found)"
  fi
  echo ""
  echo "💡 Tip: Run 'alarm add <file_or_url>' or 'alarm open' to add sounds"
  exit 0
fi

# =================================================================
# Sound Playback & Agent Detection
# =================================================================

AGENT=""
case "${1:-}" in
  claude|codex|antigravity|opencode)
    AGENT="$1"
    ;;
  --agent)
    AGENT="${2:-}"
    ;;
esac

# Auto-detect caller if not explicitly passed
if [ -z "$AGENT" ]; then
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ] || [ -n "${CLAUDE_SESSION_ID:-}" ]; then
    AGENT="claude"
  elif [ -n "${CODEX_SESSION_ID:-}" ] || [ -n "${CODEX_PROJECT_ROOT:-}" ]; then
    AGENT="codex"
  else
    PARENT_COMM="$(ps -o comm= -p "$PPID" 2>/dev/null || true)"
    GRANDPARENT_PID="$(ps -o ppid= -p "$PPID" 2>/dev/null || true | tr -d ' ')"
    GRANDPARENT_COMM=""
    if [ -n "$GRANDPARENT_PID" ]; then
      GRANDPARENT_COMM="$(ps -o comm= -p "$GRANDPARENT_PID" 2>/dev/null || true)"
    fi
    CALLER_CHAIN="$PARENT_COMM $GRANDPARENT_COMM"

    if [[ "$CALLER_CHAIN" =~ claude ]]; then
      AGENT="claude"
    elif [[ "$CALLER_CHAIN" =~ codex ]]; then
      AGENT="codex"
    elif [[ "$CALLER_CHAIN" =~ (antigravity|agy) ]]; then
      AGENT="antigravity"
    elif [[ "$CALLER_CHAIN" =~ opencode ]]; then
      AGENT="opencode"
    fi
  fi
fi

# Locate Sound File
SOUND=""

find_audio_file() {
  local prefix="$1"
  shopt -s nullglob nocaseglob
  for candidate in "$prefix".{mp3,wav,m4a,aac,ogg,flac,aiff}; do
    if [ -f "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  echo ""
}

# 1. Agent custom sound
if [ -n "$AGENT" ]; then
  SOUND="$(find_audio_file "$INSTALL_DIR/alarm_sound_${AGENT}")"
  if [ -z "$SOUND" ]; then
    SOUND="$(find_audio_file "$DIR/alarm_sound_${AGENT}")"
  fi
fi

# 2. Global default sound
if [ -z "$SOUND" ]; then
  SOUND="$(find_audio_file "$INSTALL_DIR/alarm_sound")"
  if [ -z "$SOUND" ]; then
    SOUND="$(find_audio_file "$DIR/alarm_sound")"
  fi
fi

# 3. First sound in library
if [ -z "$SOUND" ] && [ -n "$SOUND_DIR" ] && [ -d "$SOUND_DIR" ]; then
  shopt -s nullglob nocaseglob
  FIRST_AUDIO=( "$SOUND_DIR"/*.{mp3,wav,m4a,aac,ogg,flac,aiff} )
  if [ -f "${FIRST_AUDIO[0]}" ]; then
    SOUND="${FIRST_AUDIO[0]}"
  fi
fi

if [ -z "$SOUND" ] || [ ! -f "$SOUND" ]; then
  echo "Error: No alarm sound found in $INSTALL_DIR or $DIR" >&2
  echo "Run 'alarm --help' or 'alarm --select' to configure." >&2
  exit 1
fi

# Play Sound using native system player
play_audio() {
  if command -v afplay >/dev/null 2>&1; then
    afplay "$SOUND"
  elif command -v paplay >/dev/null 2>&1; then
    paplay "$SOUND"
  elif command -v mpv >/dev/null 2>&1; then
    mpv --no-video "$SOUND" >/dev/null 2>&1
  elif command -v ffplay >/dev/null 2>&1; then
    ffplay -nodisp -autoexit "$SOUND" >/dev/null 2>&1
  elif command -v aplay >/dev/null 2>&1; then
    aplay "$SOUND"
  else
    echo -e "\a"
  fi
}

# If called by an agent hook or non-interactively, play in background so agent is not blocked
if [ -n "$AGENT" ] || [ ! -t 0 ]; then
  (play_audio >/dev/null 2>&1 &)
  # Antigravity hook contract expects JSON on stdout
  if [ "$AGENT" = "antigravity" ] || [ -n "${ANTIGRAVITY_APP_ROOT:-}" ] || [ -n "${AGY_CLI:-}" ]; then
    echo "{}"
  fi
  exit 0
else
  play_audio
fi
