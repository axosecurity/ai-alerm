#!/usr/bin/env bash
set -eo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="${HOME}/.ai-alarm"
CONFIG_FILE="$INSTALL_DIR/config.json"

get_config_val() {
  local key="$1"
  local default="$2"
  if [ -f "$CONFIG_FILE" ]; then
    node -e '
      const fs = require("fs");
      try {
        const c = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
        const v = c[process.argv[2]];
        if (v !== undefined) { console.log(String(v)); process.exit(0); }
      } catch(e){}
      console.log(String(process.argv[3]));
    ' "$CONFIG_FILE" "$key" "$default" 2>/dev/null || echo "$default"
  else
    echo "$default"
  fi
}

set_config_val() {
  local key="$1"
  local val="$2"
  mkdir -p "$INSTALL_DIR"
  node -e '
    const fs = require("fs");
    const p = process.argv[1];
    const key = process.argv[2];
    let val = process.argv[3];
    if (val === "true") val = true;
    else if (val === "false") val = false;
    else if (!isNaN(val) && val.trim() !== "") val = Number(val);

    let c = { volume: 80, muted: false, desktop_notifications: true };
    if (fs.existsSync(p)) {
      try { c = Object.assign(c, JSON.parse(fs.readFileSync(p, "utf8"))); } catch(e){}
    }
    c[key] = val;
    fs.writeFileSync(p, JSON.stringify(c, null, 2) + "\n");
  ' "$CONFIG_FILE" "$key" "$val" 2>/dev/null || true
}

send_slack_payload() {
  local webhook_url="$1"
  local json_payload="$2"
  if [ -n "$webhook_url" ] && [ -n "$json_payload" ]; then
    (curl -s -X POST -H 'Content-type: application/json' \
      --data "$json_payload" \
      "$webhook_url" >/dev/null 2>&1 &)
  fi
}

get_system_context() {
  local target_dir="${1:-$PWD}"
  [ -d "$target_dir" ] || target_dir="$PWD"

  local git_root
  git_root="$(git -C "$target_dir" rev-parse --show-toplevel 2>/dev/null || echo "$target_dir")"
  local proj_name
  proj_name="$(basename "$git_root")"
  local branch
  branch="$(git -C "$target_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "no git")"
  local ts
  ts="$(date "+%Y-%m-%d %H:%M:%S %Z")"

  echo "$proj_name|$branch|$ts|$target_dir"
}

send_milestone_notification() {
  local agent_name="${1:-}"
  local task_title="${2:-Task Update}"
  local summary="${3:-Work completed successfully.}"
  local action_needed="${4:-No immediate action needed.}"
  local status="${5:-completed}"
  local target_dir="${6:-$PWD}"

  local DESKTOP_NOTIFY="$(get_config_val "desktop_notifications" "true")"
  local NOTIF_SOUND="$(get_config_val "notification_sound" "false")"
  local NOTIF_TITLE="$(get_config_val "notification_title" "AI-Alarm")"
  local WEBHOOK_URL="$(get_config_val "webhook_url" "")"

  local agent_title="AI Agent"
  case "$agent_name" in
    claude) agent_title="Claude Code" ;;
    codex) agent_title="OpenAI Codex" ;;
    antigravity) agent_title="Google Antigravity" ;;
    opencode) agent_title="OpenCode" ;;
    test) agent_title="AI-Alarm Test" ;;
    *) [ -n "$agent_name" ] && agent_title="$agent_name" ;;
  esac

  local ctx
  ctx="$(get_system_context "$target_dir")"
  IFS='|' read -r proj_name branch ts resolved_dir <<< "$ctx"

  # Native Desktop Banner
  if [ "$DESKTOP_NOTIFY" != "false" ]; then
    local mac_sound=""
    [ "$NOTIF_SOUND" = "true" ] && mac_sound="Submarine"
    local banner_msg="[${proj_name}] ${task_title}"
    if [[ "$OSTYPE" == "darwin"* ]] && command -v osascript >/dev/null 2>&1; then
      (osascript -e "display notification \"${summary}\" with title \"${NOTIF_TITLE}: ${agent_title}\" subtitle \"${banner_msg}\" sound name \"${mac_sound}\"" >/dev/null 2>&1 &)
    elif command -v notify-send >/dev/null 2>&1; then
      (notify-send "${NOTIF_TITLE}: ${agent_title}" "${banner_msg}\n${summary}" --icon=dialog-information >/dev/null 2>&1 &)
    fi
  fi

  # Rich Slack Webhook Notification
  if [ -n "$WEBHOOK_URL" ]; then
    local payload
    payload="$(node -e '
      const agent = process.argv[1];
      const task = process.argv[2];
      const summary = process.argv[3];
      const action = process.argv[4];
      const status = process.argv[5];
      const project = process.argv[6];
      const branch = process.argv[7];
      const timestamp = process.argv[8];
      const dir = process.argv[9];
      const notifTitle = process.argv[10];

      const isReview = status === "review_needed" || status === "attention_required";
      const isFailed = status === "failed" || status === "error";

      const badge = isReview ? "🚨 [ATTENTION REQUIRED]" : (isFailed ? "⚠️ [TASK BLOCKED]" : "🏁 [MISSION COMPLETE]");
      const statusText = isReview ? "⚠️ Review / Decision Required" : (isFailed ? "❌ Blocked / Failed" : "✅ Completed");
      const headerText = `${isReview ? "🚨" : (isFailed ? "⚠️" : "🏁")} ${agent}: ${task}`;

      const fallbackText = `${badge} *${agent}*\n📋 *Task:* ${task}\n📦 *Project:* \`${project}\` (\`${branch}\`)\n🕒 *Time:* ${timestamp}\n👉 *Action:* ${action}\n📍 *Dir:* \`${dir}\``;

      const body = {
        text: fallbackText,
        blocks: [
          {
            type: "header",
            text: {
              type: "plain_text",
              text: headerText.slice(0, 150),
              emoji: true
            }
          },
          {
            type: "context",
            elements: [
              {
                type: "mrkdwn",
                text: "🛡️ *Verified Root Milestone* • Not a transient sub-agent"
              }
            ]
          },
          {
            type: "section",
            fields: [
              { type: "mrkdwn", text: `*Agent:*\n🤖 ${agent}` },
              { type: "mrkdwn", text: `*Status:*\n${statusText}` },
              { type: "mrkdwn", text: `*Project & Branch:*\n📦 \`${project}\` (\`${branch}\`)` },
              { type: "mrkdwn", text: `*Timestamp:*\n🕒 ${timestamp}` }
            ]
          },
          {
            type: "section",
            text: {
              type: "mrkdwn",
              text: `*What Was Accomplished:*\n${summary}`
            }
          },
          {
            type: "section",
            text: {
              type: "mrkdwn",
              text: `*👉 Action Needed from You:*\n${action}`
            }
          },
          {
            type: "section",
            text: {
              type: "mrkdwn",
              text: `*Working Directory:*\n📂 \`${dir}\``
            }
          }
        ]
      };
      console.log(JSON.stringify(body));
    ' "$agent_title" "$task_title" "$summary" "$action_needed" "$status" "$proj_name" "$branch" "$ts" "$resolved_dir" "$NOTIF_TITLE" 2>/dev/null || true)"

    if [ -n "$payload" ]; then
      send_slack_payload "$WEBHOOK_URL" "$payload"
    fi
  fi
}

send_desktop_notification() {
  local agent_name="${1:-}"
  local custom_msg="${2:-}"
  local DESKTOP_NOTIFY="$(get_config_val "desktop_notifications" "true")"
  local NOTIF_SOUND="$(get_config_val "notification_sound" "false")"
  local NOTIF_TITLE="$(get_config_val "notification_title" "AI-Alarm")"
  local WEBHOOK_URL="$(get_config_val "webhook_url" "")"
  local ROUTINE_WEBHOOK="$(get_config_val "routine_webhook" "false")"

  local agent_title="AI Agent"
  case "$agent_name" in
    claude) agent_title="Claude Code" ;;
    codex) agent_title="OpenAI Codex" ;;
    antigravity) agent_title="Google Antigravity" ;;
    opencode) agent_title="OpenCode" ;;
    test) agent_title="AI-Alarm Test" ;;
    *) [ -n "$agent_name" ] && agent_title="$agent_name" ;;
  esac

  local msg="${custom_msg:-Task completed by ${agent_title}!}"

  if [ "$DESKTOP_NOTIFY" != "false" ]; then
    local mac_sound=""
    [ "$NOTIF_SOUND" = "true" ] && mac_sound="Submarine"
    if [[ "$OSTYPE" == "darwin"* ]] && command -v osascript >/dev/null 2>&1; then
      (osascript -e "display notification \"${msg}\" with title \"${NOTIF_TITLE}\" subtitle \"Task Finished\" sound name \"${mac_sound}\"" >/dev/null 2>&1 &)
    elif command -v notify-send >/dev/null 2>&1; then
      (notify-send "${NOTIF_TITLE}" "${msg}" --icon=dialog-information >/dev/null 2>&1 &)
    fi
  fi

  # Routine webhooks are silenced by default to prevent subagent flooding.
  # Use 'alarm milestone' for verified root agent notifications.
  if [ -n "$WEBHOOK_URL" ] && [ "$ROUTINE_WEBHOOK" = "true" ]; then
    local ctx
    ctx="$(get_system_context "$PWD")"
    IFS='|' read -r proj_name branch ts resolved_dir <<< "$ctx"

    local routine_payload
    routine_payload="$(node -e '
      const agent = process.argv[1];
      const msg = process.argv[2];
      const project = process.argv[3];
      const branch = process.argv[4];
      const timestamp = process.argv[5];
      const dir = process.argv[6];
      const notifTitle = process.argv[7];

      const body = {
        text: `🔔 [${notifTitle}] ${msg}\n📦 \`${project}\` (\`${branch}\`) • 🕒 ${timestamp}\n📍 \`${dir}\``
      };
      console.log(JSON.stringify(body));
    ' "$agent_title" "$msg" "$proj_name" "$branch" "$ts" "$resolved_dir" "$NOTIF_TITLE" 2>/dev/null || true)"

    if [ -n "$routine_payload" ]; then
      send_slack_payload "$WEBHOOK_URL" "$routine_payload"
    fi
  fi
}

# Resolve Global Sound Library Directory
SOUND_DIR=""
if [ -n "${AI_ALARM_SOUND_DIR:-}" ] && [ -d "$AI_ALARM_SOUND_DIR" ]; then
  SOUND_DIR="$AI_ALARM_SOUND_DIR"
elif [ -d "$INSTALL_DIR/sound" ]; then
  SOUND_DIR="$INSTALL_DIR/sound"
elif [ -d "$DIR/sound" ]; then
  SOUND_DIR="$DIR/sound"
fi

